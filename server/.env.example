# Server Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# JWT Secret for signing auth tokens (change in production)
JWT_SECRET=food_rescue_super_secret_jwt_key_2026

# Client URL for CORS (your frontend dev server)
CLIENT_URL=http://localhost:5173

# MongoDB Connection (if using MongoDB)
# MONGO_URI=mongodb://localhost:27017/food_rescue_db

# (Optional) Twilio for real OTP SMS
# TWILIO_ACCOUNT_SID=ACxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

